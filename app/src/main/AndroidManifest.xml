<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ticket 03: provider transports (Gemini / OpenAI-compatible) reach the network
         only through the egress chokepoint; no other outbound call exists in the app. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Ticket 04: processing chip notification + expedited-work foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <!-- Explicit-share ingest only (privacy-first): Share sheet, clipboard
         auto-add (opt-in, foreground-only). No media permissions needed. -->

    <application
        android:name=".MindverseApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="Mindverse"
        android:theme="@style/Theme.Mindverse">

        <!-- Ticket 04: WorkManager initializes on demand from MindverseApp's
             Configuration.Provider (HiltWorkerFactory); the startup initializer must not
             win the race with a default factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Expedited work promotes to a foreground service; declare the types used by
             PipelineForeground (dataSync on API 34, mediaProcessing on 35+). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync|mediaProcessing"
            tools:node="merge" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links (spec R4-7): processing chip → memory, ticket 06 nav surfaces. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mindverse" />
            </intent-filter>
        </activity>

        <!-- Ticket 05: Share-sheet trampoline. Text, images, PDFs; no permissions beyond
             the intent itself (blobs are copied into app-private storage). -->
        <activity
            android:name=".triggers.share.ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Ticket 05: Quick Settings tile (M1: opens the dashboard). -->
        <service
            android:name=".triggers.tile.MindverseTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_compass"
            android:label="Mindverse"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
